#!/bin/bash
# Fausse notification. Avec --wait : renvoie « handover » si $FAKE/click apparaît.
[[ $1 == --help ]] && { echo "  -A, --action=[NAME=]Text..."; exit 0; }
echo "NOTIFICATION" >>"$FAKE/events"
[[ " $* " == *" --wait "* ]] || exit 0
for _ in $(seq 100); do
	[[ -e $FAKE/click ]] && { rm -f "$FAKE/click"; echo handover; exit 0; }
	sleep 0.1
done
