#!/bin/bash
# Faux ss : une connexion établie par Steam pour chaque IP listée dans $FAKE/peers,
# plus un serveur de Valve (toujours présent, sans effet).
echo 'tcp   0      0      192.168.88.88:41000   155.133.226.10:27017 users:(("steam",pid=100,fd=40))'
[[ -s $FAKE/peers ]] || exit 0
while read -r ip; do
	echo "tcp   0      0      192.168.88.88:27036   $ip:51234 users:((\"steam\",pid=100,fd=41))"
	echo "udp   0      0      [::ffff:192.168.88.88]:53873   [::ffff:$ip]:50000 users:((\"steam\",pid=100,fd=42))"
done <"$FAKE/peers"
