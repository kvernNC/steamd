# steamd — copier dans ~/.config/steamd/steamd.conf (fait par install.sh)
WIDTH=1280
HEIGHT=800
REFRESH=60                      # fréquence du client : 90 pour un Deck OLED
STEAM_CAPTURE=pipewire-dmabuf   # pipewire-dmabuf | pipewire | none
GAMESCOPE_EXTRA_ARGS=""         # ex. "--verbose"
STEAM_EXTRA_ARGS=""
# HOME dédié du client Steam de steamd (distinct du Steam du bureau)
#STEAMD_HOME="$HOME/.local/share/steamd-home"
