# steamd — configuration
# Copier dans ~/.config/steamd/steamd.conf (install.sh le fait s'il n'existe pas).
# Le fichier est lu par bash : syntaxe VAR=valeur, sans espace autour du "=".
# Les commentaires en fin de ligne sont autorisés.

# --- Affichage gamescope ------------------------------------------------------
# Résolution de sortie de gamescope (-W/-H) et fréquence (-r).
WIDTH=1280
HEIGHT=800
REFRESH=60
# Résolution vue par l'application (-w/-h). Vide = identique à WIDTH/HEIGHT.
APP_WIDTH=""
APP_HEIGHT=""

# --- Steam --------------------------------------------------------------------
# Mode de capture pour Remote Play :
#   pipewire-dmabuf  -> steam -pipewire-dmabuf (par défaut)
#   pipewire         -> steam -pipewire        (plan B si écran noir)
#   none             -> aucune option          (plan C)
STEAM_CAPTURE=pipewire-dmabuf
# Interface de Steam : -tenfoot (Big Picture) ou -gamepadui.
STEAM_UI_ARG="-tenfoot"

# Options supplémentaires, séparées par des espaces (pas de guillemets imbriqués).
# Exemple de logs gamescope détaillés : GAMESCOPE_EXTRA_ARGS="--verbose"
GAMESCOPE_EXTRA_ARGS=""
STEAM_EXTRA_ARGS=""

# --- Cohabitation avec la session de bureau -----------------------------------
# Règle de base : une partie en cours n'est jamais interrompue. steamd ne tue
# jamais un Steam qu'il n'a pas lancé lui-même (celui du bureau par exemple) :
# il attend qu'il se ferme. Une session verrouillée reste une session ouverte.
#   yield     (défaut) quand une session graphique locale s'ouvre :
#             - pas de partie Remote Play en cours : Steam headless est fermé
#               tout de suite pour laisser la place au Steam du bureau ;
#             - partie Remote Play en cours : elle continue, le bureau reçoit
#               une notification, et à la fin de la partie Steam headless est
#               fermé puis le Steam du bureau lancé.
#             steamd reste en veille et reprend après la déconnexion.
#   takeover  Steam headless reste actif même pendant une session de bureau
#             (le Steam du bureau s'ouvre alors dans l'instance headless,
#             invisible à l'écran).
DESKTOP_SESSION_POLICY=yield
# Après la fin d'une partie, délai avant de rendre la main au bureau : laisse
# le temps d'enchaîner (relance du jeu, launcher, partie suivante).
HANDOVER_DELAY=15
# Lancer automatiquement le Steam du bureau après le passage de main.
# false : simple notification « Steam est disponible ».
RESUME_DESKTOP_STEAM=true
# Options du Steam lancé sur le bureau (ex. "-silent" pour le garder réduit).
DESKTOP_STEAM_ARGS=""
# Notifications sur le bureau (notify-send, paquet libnotify).
NOTIFY=true

# --- Énergie --------------------------------------------------------------------
# Bloquer la mise en veille du PC pendant une partie Remote Play.
INHIBIT_SLEEP_DURING_GAME=true
# Que faire quand le PC tourne sans aucune session (ni bureau, ni SSH) et sans
# partie depuis IDLE_TIMEOUT secondes :
#   none      ne rien faire (défaut)
#   suspend   mise en veille : à n'utiliser que si le Wake-on-LAN réveille le
#             PC depuis la veille
#   poweroff  extinction : le Wake-on-LAN depuis l'arrêt suffit
IDLE_ACTION=none
IDLE_TIMEOUT=1800

# --- Délais (secondes) --------------------------------------------------------
# Intervalle entre deux vérifications (session, Steam). La connexion au bureau
# est détectée tout de suite grâce à steamd-session-hook.
POLL_INTERVAL=5
# Délai avant de relancer Steam headless après une fin inattendue
# (multiplié par le nombre d'échecs rapprochés, plafonné à 300).
RESTART_DELAY=10
# Temps laissé à Steam pour se fermer proprement avant d'être forcé.
STOP_TIMEOUT=30

# --- Binaires (rarement utile) ------------------------------------------------
GAMESCOPE_BIN=gamescope
STEAM_BIN=steam
