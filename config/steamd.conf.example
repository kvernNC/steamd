# steamd — configuration
# Copier dans ~/.config/steamd/steamd.conf (install.sh le fait s'il n'existe pas).
# Le fichier est lu par bash : syntaxe VAR=valeur, sans espace autour du "=".
# Les commentaires en fin de ligne sont autorisés.

# --- Affichage gamescope ------------------------------------------------------
# Résolution de sortie de gamescope (-W/-H) et fréquence (-r).
WIDTH=1280
HEIGHT=800
REFRESH=60
# Résolution vue par l'application (-w/-h). Vide = identique à WIDTH/HEIGHT.
APP_WIDTH=""
APP_HEIGHT=""

# --- Steam --------------------------------------------------------------------
# Mode de capture pour Remote Play :
#   pipewire-dmabuf  -> steam -pipewire-dmabuf (par défaut)
#   pipewire         -> steam -pipewire        (plan B si écran noir)
#   none             -> aucune option          (plan C)
STEAM_CAPTURE=pipewire-dmabuf
# Interface de Steam : -tenfoot (Big Picture) ou -gamepadui.
STEAM_UI_ARG="-tenfoot"

# Options supplémentaires, séparées par des espaces (pas de guillemets imbriqués).
# Exemple de logs gamescope détaillés : GAMESCOPE_EXTRA_ARGS="--verbose"
GAMESCOPE_EXTRA_ARGS=""
STEAM_EXTRA_ARGS=""

# --- Optimisation des jeux pour le stream (Steam headless seulement) -----------
# Tout ce qui suit s'applique à tous les jeux lancés par steamd, jamais au
# Steam du bureau. Les options de lancement d'un jeu dans Steam
# (VAR=... %command%) restent prioritaires pour ce jeu.

# Réglages de base pour le stream :
#   DXVK_CONFIG=dxgi.maxFrameLatency=1;d3d9.maxFrameLatency=1
#     une seule image préparée d'avance au lieu de 3 : moins de latence,
#     un peu moins d'images par seconde quand le processeur est limitant
#   PROTON_DXVK_LOWLATENCY=1 PROTON_VKD3D_LOWLATENCY=1
#     Proton-CachyOS : variantes « low latency » de DXVK (Direct3D 9 à 11) et
#     de VKD3D-Proton (Direct3D 12), meilleur rythme d'images ; ignorées par
#     les autres versions de Proton
#   PROTON_USE_NTSYNC=1
#     synchronisation ntsync (moins de micro-saccades), ignorée si la version
#     de Proton ne la gère pas (steamd-doctor indique ce qu'il en est)
# Pour retirer un seul de ces réglages, le remettre à 0 dans STEAM_ENV, par
# exemple "PROTON_DXVK_LOWLATENCY=0".
STREAM_TUNING=true

# Limite d'images par seconde :
#   auto  (défaut) égale à REFRESH, la fréquence de capture
#   0     pas de limite
#   N     par exemple 45 avec REFRESH=90 pour un jeu lourd : un rythme stable
#         à un sous-multiple de la capture est plus fluide qu'un rythme
#         irrégulier proche de REFRESH
FPS_LIMIT=auto
#   mangohud  (défaut) couche Vulkan MangoHud, invisible (no_display) : couvre
#             les jeux natifs et ceux sous Proton. Paquet mangohud.
#   dxvk      limiteurs intégrés de DXVK et VKD3D-Proton, sans MangoHud
#             (jeux Windows sous Proton seulement).
FPS_LIMIT_METHOD=mangohud
# Avec MangoHud : late = latence la plus basse, early = intervalles plus réguliers.
FPS_LIMIT_TIMING=late

# Variables d'environnement supplémentaires pour tous les jeux, NOM=valeur.
# Elles passent en dernier et remplacent celles ci-dessus si le nom est le même.
STEAM_ENV=(
	# "DXVK_HUD=fps"
)

# --- Réglages de Steam pilotés par steamd ---------------------------------------
# Écrits dans les fichiers de Steam juste avant chaque lancement de Steam
# headless (Steam fermé, il ne les écrase donc pas). Les fichiers étant ceux
# de votre compte, ces réglages valent aussi pour le Steam du bureau.
# Format : "FICHIER:CLÉ=VALEUR", FICHIER relatif à ~/.steam/steam.
# Pour trouver la clé d'une option de l'interface de Steam :
#   1. fermer Steam, puis : steamd-steamcfg snapshot
#   2. ouvrir Steam, changer l'option, fermer Steam
#   3. steamd-steamcfg diff   -> affiche les lignes à copier ici
STEAM_SETTINGS=(
	# "userdata/*/config/localconfig.vdf:UserLocalConfigStore/.../Option=1"
)

# --- Cohabitation avec la session de bureau -----------------------------------
# Règle de base : une partie en cours n'est jamais interrompue. steamd ne tue
# jamais un Steam qu'il n'a pas lancé lui-même (celui du bureau par exemple) :
# il attend qu'il se ferme. Une session verrouillée reste une session ouverte.
#   yield     (défaut) quand une session graphique locale s'ouvre :
#             - pas de partie Remote Play en cours : Steam headless est fermé
#               tout de suite pour laisser la place au Steam du bureau ;
#             - partie Remote Play en cours : elle continue, le bureau reçoit
#               une notification, et à la fin de la partie Steam headless est
#               fermé puis le Steam du bureau lancé.
#             steamd reste en veille et reprend après la déconnexion.
#   takeover  Steam headless reste actif même pendant une session de bureau
#             (le Steam du bureau s'ouvre alors dans l'instance headless,
#             invisible à l'écran).
DESKTOP_SESSION_POLICY=yield
# Après la fin d'une partie, délai avant de rendre la main au bureau : laisse
# le temps d'enchaîner (relance du jeu, launcher, partie suivante).
HANDOVER_DELAY=15
# Lancer automatiquement le Steam du bureau après le passage de main.
# false : simple notification « Steam est disponible ».
RESUME_DESKTOP_STEAM=true
# Options du Steam lancé sur le bureau (ex. "-silent" pour le garder réduit).
DESKTOP_STEAM_ARGS=""
# Notifications sur le bureau (notify-send, paquet libnotify). Si une session
# s'ouvre pendant une partie Remote Play, une popup propose « Fermer la partie
# et ouvrir Steam ici » ou « Attendre la fin ».
NOTIFY=true

# --- Énergie --------------------------------------------------------------------
# Bloquer la mise en veille du PC pendant une partie Remote Play.
INHIBIT_SLEEP_DURING_GAME=true
# Que faire quand le PC tourne sans aucune session (ni bureau, ni SSH) et sans
# partie depuis IDLE_TIMEOUT secondes :
#   none      ne rien faire (défaut)
#   suspend   mise en veille : à n'utiliser que si le Wake-on-LAN réveille le
#             PC depuis la veille
#   poweroff  extinction : le Wake-on-LAN depuis l'arrêt suffit
IDLE_ACTION=none
IDLE_TIMEOUT=1800

# --- Délais (secondes) --------------------------------------------------------
# Intervalle entre deux vérifications (session, Steam). La connexion au bureau
# est détectée tout de suite grâce à steamd-session-hook.
POLL_INTERVAL=5
# Délai avant de relancer Steam headless après une fin inattendue
# (multiplié par le nombre d'échecs rapprochés, plafonné à 300).
RESTART_DELAY=10
# Temps laissé à Steam pour se fermer proprement avant d'être forcé.
STOP_TIMEOUT=30

# --- Binaires (rarement utile) ------------------------------------------------
GAMESCOPE_BIN=gamescope
STEAM_BIN=steam
