# Paquet construit depuis l'arbre du dépôt : cd packaging/arch && makepkg -si
pkgname=steamd
pkgver=0.1.0
pkgrel=4
pkgdesc="Steam headless dans gamescope en service utilisateur, pour Steam Remote Play"
arch=('x86_64')
license=('MIT')
depends=('bash' 'gamescope' 'steam' 'pipewire' 'pipewire-pulse' 'wireplumber' 'systemd')
makedepends=('gcc' 'libva')
optdepends=('mangohud: FPS_LIMIT par la couche Vulkan (sinon DXVK/VKD3D seulement)'
            'python: STEAM_SETTINGS et steamd-steamcfg'
            'power-profiles-daemon: GAME_POWER_PROFILE pendant les parties'
            'amf-amdgpu-pro: AMF_ENCODER (AV1 sur GPU AMD)')
backup=()
install=steamd.install

build() {
    cc $CFLAGS -fPIC -shared $LDFLAGS -o "$srcdir/libsteamd-vaapi.so" "$startdir/../../src/steamd-vaapi.c" -ldl -lpthread
    cc $CFLAGS -fPIC -shared $LDFLAGS -o "$srcdir/libsteamd-amf.so" "$startdir/../../src/steamd-amf.c" -ldl -lpthread
}

package() {
    local src="$startdir/../.."

    install -Dm755 "$srcdir/libsteamd-vaapi.so" "$pkgdir/usr/lib/steamd/libsteamd-vaapi.so"
    install -Dm755 "$srcdir/libsteamd-amf.so" "$pkgdir/usr/lib/steamd/libsteamd-amf.so"
    install -Dm755 -t "$pkgdir/usr/bin" \
        "$src"/bin/steamd-{launch,doctor,setup,profiled,steamcfg,probe}

    install -dm755 "$pkgdir/usr/lib/systemd/user"
    for u in "$src"/systemd/*.service; do
        sed 's|@BINDIR@|/usr/bin|' "$u" > "$pkgdir/usr/lib/systemd/user/$(basename "$u")"
    done

    install -Dm644 "$src/udev/60-steamd-uinput.rules" "$pkgdir/usr/lib/udev/rules.d/60-steamd-uinput.rules"
    install -Dm644 "$src/udev/steamd-uinput.conf" "$pkgdir/usr/lib/modules-load.d/steamd-uinput.conf"
    install -Dm644 "$src/config/steamd.conf.example" "$pkgdir/usr/share/steamd/steamd.conf.example"
    install -Dm755 "$src/deck/wake-host.sh" "$pkgdir/usr/share/steamd/deck/wake-host.sh"
    install -Dm755 "$src/wifi/wifi-tune.sh" "$pkgdir/usr/share/steamd/wifi/wifi-tune.sh"
    install -Dm644 "$src/polkit/60-steamd.rules" "$pkgdir/usr/share/steamd/polkit/60-steamd.rules"
    install -Dm644 "$src/README.md" "$pkgdir/usr/share/doc/steamd/README.md"
    install -Dm644 "$src/LICENSE" "$pkgdir/usr/share/licenses/steamd/LICENSE"
}
