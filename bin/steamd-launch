#!/usr/bin/env bash
# steamd-launch : superviseur permanent de Steam (Big Picture) dans un
# gamescope headless, pour Steam Remote Play.
#
#   steamd-launch           boucle de supervision (ExecStart de steamd.service)
#   steamd-launch --print   affiche la commande gamescope, sans l'exécuter
#   steamd-launch --status  affiche l'état courant (running, standby, ...)
#   steamd-launch --handover  depuis le bureau : ferme Steam headless (et la
#                             partie Remote Play en cours) et ouvre Steam ici
#
# Le service ne s'arrête jamais de lui-même. Règle de base : une partie en
# cours n'est jamais interrompue, quel que soit le Steam qui la fait tourner.
# À chaque tour de boucle :
#   - aucune session graphique locale        -> Steam headless lancé (running)
#   - session graphique locale ouverte       -> selon DESKTOP_SESSION_POLICY :
#       yield    (défaut) : si une partie Remote Play est en cours, elle continue
#                           (busy) et le bureau est prévenu ; à la fin de la
#                           partie, Steam headless est fermé et le Steam du
#                           bureau lancé. Une popup propose aussi de fermer
#                           la partie tout de suite (--handover). Sinon, Steam
#                           headless est fermé tout de suite (standby).
#       takeover          : Steam headless gardé, même avec une session ouverte
#   - un autre Steam tourne (bureau, lancé à la main...) -> jamais tué ; steamd
#     attend qu'il se ferme (standby)
#   - sans aucune session et sans partie depuis IDLE_TIMEOUT -> IDLE_ACTION
#     (none, suspend ou poweroff)
# Pendant une partie Remote Play, la mise en veille du PC est bloquée.
# SIGUSR1 force une réévaluation immédiate (envoyé par steamd-session-hook).
#
# Code de sortie 2 : configuration invalide (systemd ne relance pas).
set -euo pipefail

USER=${USER:-$(id -un)}

readonly EXIT_CONFIG=2

log() { printf 'steamd: %s\n' "$*" >&2; }
die() {
	local code=$1
	shift
	log "ERREUR: $*"
	exit "$code"
}

CONF="${STEAMD_CONF:-${XDG_CONFIG_HOME:-$HOME/.config}/steamd/steamd.conf}"
RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$UID}/steamd"
STATE_FILE="$RUNTIME_DIR/state"
HANDOVER_FILE="$RUNTIME_DIR/handover"

# --- Valeurs par défaut (écrasées par la conf) --------------------------------
WIDTH=1280
HEIGHT=800
REFRESH=60
APP_WIDTH=""
APP_HEIGHT=""
STEAM_CAPTURE=pipewire-dmabuf
STEAM_UI_ARG="-tenfoot"
GAMESCOPE_EXTRA_ARGS=""
STEAM_EXTRA_ARGS=""
DESKTOP_SESSION_POLICY=yield
HANDOVER_DELAY=15
RESUME_DESKTOP_STEAM=true
DESKTOP_STEAM_ARGS=""
NOTIFY=true
INHIBIT_SLEEP_DURING_GAME=true
IDLE_ACTION=none
IDLE_TIMEOUT=1800
POLL_INTERVAL=5
RESTART_DELAY=10
STOP_TIMEOUT=30
GAMESCOPE_BIN=gamescope
STEAM_BIN=steam

load_conf() {
	if [[ -r $CONF ]]; then
		# shellcheck source=/dev/null
		source "$CONF"
	else
		log "pas de configuration ($CONF), valeurs par défaut utilisées"
	fi
}

is_uint() { [[ $1 =~ ^[0-9]+$ ]]; }

validate_conf() {
	local v
	for v in WIDTH HEIGHT REFRESH POLL_INTERVAL RESTART_DELAY STOP_TIMEOUT HANDOVER_DELAY IDLE_TIMEOUT; do
		is_uint "${!v}" || die $EXIT_CONFIG "$v doit être un entier (valeur : '${!v}')"
	done
	((POLL_INTERVAL >= 1)) || die $EXIT_CONFIG "POLL_INTERVAL doit être >= 1"
	for v in APP_WIDTH APP_HEIGHT; do
		[[ -z ${!v} ]] || is_uint "${!v}" || die $EXIT_CONFIG "$v doit être vide ou entier (valeur : '${!v}')"
	done
	case $STEAM_CAPTURE in
	pipewire-dmabuf | pipewire | none) ;;
	*) die $EXIT_CONFIG "STEAM_CAPTURE doit valoir pipewire-dmabuf, pipewire ou none (valeur : '$STEAM_CAPTURE')" ;;
	esac
	case $DESKTOP_SESSION_POLICY in
	yield | takeover) ;;
	*) die $EXIT_CONFIG "DESKTOP_SESSION_POLICY doit valoir yield ou takeover (valeur : '$DESKTOP_SESSION_POLICY')" ;;
	esac
	case $IDLE_ACTION in
	none | suspend | poweroff) ;;
	*) die $EXIT_CONFIG "IDLE_ACTION doit valoir none, suspend ou poweroff (valeur : '$IDLE_ACTION')" ;;
	esac
	((IDLE_TIMEOUT >= 60)) || die $EXIT_CONFIG "IDLE_TIMEOUT doit être >= 60"
	command -v "$GAMESCOPE_BIN" >/dev/null || die $EXIT_CONFIG "gamescope introuvable ($GAMESCOPE_BIN)"
	command -v "$STEAM_BIN" >/dev/null || die $EXIT_CONFIG "steam introuvable ($STEAM_BIN)"
}

build_command() {
	local -a gs_extra st_extra steam_ui
	read -ra gs_extra <<<"$GAMESCOPE_EXTRA_ARGS"
	read -ra st_extra <<<"$STEAM_EXTRA_ARGS"
	read -ra steam_ui <<<"$STEAM_UI_ARG"

	CMD=("$GAMESCOPE_BIN"
		-W "$WIDTH" -H "$HEIGHT"
		-w "${APP_WIDTH:-$WIDTH}" -h "${APP_HEIGHT:-$HEIGHT}"
		-r "$REFRESH"
		--backend headless --steam
		"${gs_extra[@]}"
		--
		"$STEAM_BIN" "${steam_ui[@]}")
	case $STEAM_CAPTURE in
	pipewire-dmabuf) CMD+=(-pipewire-dmabuf) ;;
	pipewire) CMD+=(-pipewire) ;;
	none) ;;
	esac
	CMD+=("${st_extra[@]}")
}

# --- Détection ----------------------------------------------------------------

# Un Steam client tourne-t-il pour cet utilisateur (le nôtre ou un autre) ?
steam_running() { pgrep -u "$UID" -x steam >/dev/null; }

# Session graphique locale ouverte pour cet utilisateur ? On regarde logind
# (la session existe dès la connexion SDDM, avant le bureau) et
# graphical-session.target. Une session en cours de fermeture ne compte pas.
local_graphical_session() {
	local s type remote state
	for s in $(loginctl show-user "$UID" -p Sessions --value 2>/dev/null); do
		type=$(loginctl show-session "$s" -p Type --value 2>/dev/null) || continue
		remote=$(loginctl show-session "$s" -p Remote --value 2>/dev/null) || continue
		state=$(loginctl show-session "$s" -p State --value 2>/dev/null) || continue
		if [[ ($type == wayland || $type == x11) && $remote == no && $state != closing ]]; then
			return 0
		fi
	done
	systemctl --user is-active --quiet graphical-session.target 2>/dev/null
}

# Nombre de sessions d'utilisateurs ouvertes (bureau, SSH, console), tous
# utilisateurs confondus. Les sessions techniques (greeter SDDM, gestionnaire
# systemd du linger, tâches de fond) ne comptent pas.
user_sessions() {
	local s class n=0
	for s in $(loginctl list-sessions --no-legend 2>/dev/null | awk '{print $1}'); do
		class=$(loginctl show-session "$s" -p Class --value 2>/dev/null) || continue
		[[ $class == user* ]] && n=$((n + 1))
	done
	echo "$n"
}

# --- Partie en cours -----------------------------------------------------------

# Processus de Steam headless : cgroup du service sous systemd, sinon groupe
# de processus du fils.
headless_pids() {
	local cg
	cg=$(sed -n 's/^0:://p' /proc/self/cgroup 2>/dev/null)
	if [[ $cg == */steamd.service && -r /sys/fs/cgroup$cg/cgroup.procs ]]; then
		cat "/sys/fs/cgroup$cg/cgroup.procs"
	elif ((CHILD > 0)); then
		pgrep -g "$CHILD" || true
	fi
}

# AppId du jeu lancé par Steam headless, ou rien. Steam lance chaque jeu via
# « reaper SteamLaunch AppId=NNN -- ... ».
headless_game() {
	local p cmd
	while read -r p; do
		cmd=$(tr '\0' ' ' <"/proc/$p/cmdline" 2>/dev/null) || continue
		if [[ $cmd == *SteamLaunch*AppId=* ]]; then
			cmd=${cmd#*AppId=}
			echo "${cmd%% *}"
			return 0
		fi
	done < <(headless_pids)
	return 0
}

# Nom d'un jeu d'après les manifestes des bibliothèques Steam.
game_name() {
	local id=$1 root lib f name
	for root in "$HOME/.steam/steam" "$HOME/.local/share/Steam"; do
		[[ -d $root/steamapps ]] || continue
		while read -r lib; do
			f="$lib/steamapps/appmanifest_$id.acf"
			[[ -r $f ]] || continue
			name=$(sed -n 's/^[[:space:]]*"name"[[:space:]]*"\(.*\)"[[:space:]]*$/\1/p' "$f" | head -1)
			[[ -n $name ]] && {
				echo "$name"
				return 0
			}
		done < <(
			echo "$root"
			sed -n 's/^[[:space:]]*"path"[[:space:]]*"\(.*\)"[[:space:]]*$/\1/p' "$root/steamapps/libraryfolders.vdf" 2>/dev/null
		)
	done
	echo "jeu $id"
}

# --- Bureau : notification et lancement du Steam du bureau ---------------------

notify() {
	[[ $NOTIFY == true ]] || return 0
	command -v notify-send >/dev/null || return 0
	DBUS_SESSION_BUS_ADDRESS=${DBUS_SESSION_BUS_ADDRESS:-unix:path=${XDG_RUNTIME_DIR:-/run/user/$UID}/bus} \
		notify-send -a steamd -i steam "$1" "$2" >/dev/null 2>&1 || true
}

# Lance Steam dans la session graphique, dans une unité transitoire qui hérite
# de l'environnement de la session (WAYLAND_DISPLAY, DISPLAY importés par Plasma).
resume_desktop_steam() {
	if [[ $RESUME_DESKTOP_STEAM != true ]]; then
		notify "Steam est disponible" "La partie Remote Play est terminée, vous pouvez lancer Steam."
		return 0
	fi
	steam_running && return 0
	local -a args
	read -ra args <<<"$DESKTOP_STEAM_ARGS"
	log "lancement du Steam du bureau"
	systemd-run --user --quiet --collect --slice=app.slice -p ExitType=cgroup \
		--unit="steamd-desktop-steam-$(date +%s)" -- "$STEAM_BIN" "${args[@]}" ||
		log "échec du lancement du Steam du bureau"
}

# Popup sur le bureau quand une session s'ouvre pendant une partie Remote Play.
# Elle tourne en arrière-plan : le bouton « Fermer la partie » dépose une
# demande de passage de main et réveille le superviseur.
PROMPT_PID=0
ask_handover() {
	local name=$1
	[[ $NOTIFY == true ]] || return 0
	command -v notify-send >/dev/null || return 0
	export DBUS_SESSION_BUS_ADDRESS=${DBUS_SESSION_BUS_ADDRESS:-unix:path=${XDG_RUNTIME_DIR:-/run/user/$UID}/bus}
	local title="Steam est utilisé en Remote Play"
	local body="Partie en cours : $name.
Steam s'ouvrira ici automatiquement à la fin de la partie."
	if notify-send --help 2>&1 | grep -q -- '--action'; then
		(
			choice=$(notify-send -a steamd -i steam -u critical --wait \
				--action=handover="Fermer la partie et ouvrir Steam ici" \
				--action=wait="Attendre la fin" \
				"$title" "$body
Fermer la partie maintenant fait perdre la progression non sauvegardée du joueur à distance." 2>/dev/null) || true
			if [[ $choice == handover ]]; then
				: >"$HANDOVER_FILE"
				kill -USR1 $$ 2>/dev/null || true
			fi
		) &
		PROMPT_PID=$!
	else
		notify-send -a steamd -i steam "$title" "$body
Pour fermer la partie maintenant : steamd-launch --handover" >/dev/null 2>&1 || true
	fi
}
# Termine un processus et tous ses descendants.
kill_tree() {
	local c
	for c in $(pgrep -P "$1" 2>/dev/null); do kill_tree "$c"; done
	kill "$1" 2>/dev/null || true
}
close_prompt() {
	((PROMPT_PID > 0)) || return 0
	kill_tree "$PROMPT_PID"
	wait "$PROMPT_PID" 2>/dev/null || true
	PROMPT_PID=0
}

# --- Blocage de la mise en veille pendant une partie ---------------------------
INHIBIT_PID=0
inhibit_on() {
	[[ $INHIBIT_SLEEP_DURING_GAME == true ]] || return 0
	if ((INHIBIT_PID > 0)) && kill -0 "$INHIBIT_PID" 2>/dev/null; then return 0; fi
	command -v systemd-inhibit >/dev/null || return 0
	setsid systemd-inhibit --what=sleep:idle --who=steamd --why="$1" --mode=block sleep infinity &
	INHIBIT_PID=$!
	log "mise en veille bloquée : $1"
}
inhibit_off() {
	((INHIBIT_PID > 0)) || return 0
	kill -- "-$INHIBIT_PID" 2>/dev/null || true
	wait "$INHIBIT_PID" 2>/dev/null || true
	INHIBIT_PID=0
	log "mise en veille de nouveau autorisée"
}

# --- Processus fils (gamescope + Steam) ---------------------------------------
CHILD=0

child_alive() {
	((CHILD > 0)) || return 1
	local st
	st=$(awk '{print $3}' "/proc/$CHILD/stat" 2>/dev/null) || return 1
	[[ $st != Z ]]
}

start_child() {
	log "lancement : ${CMD[*]}"
	# Variables héritées d'une ancienne session de bureau (Plasma les importe
	# dans le gestionnaire systemd utilisateur) : gamescope ne doit pas
	# s'imbriquer dedans.
	# setsid : gamescope, Steam et leurs descendants forment un groupe de
	# processus à part, qu'on peut arrêter d'un coup.
	(
		unset DISPLAY WAYLAND_DISPLAY
		exec setsid "${CMD[@]}"
	) &
	CHILD=$!
	CHILD_STARTED=$SECONDS
}

# Arrêt propre : steam -shutdown, puis gamescope, puis SIGKILL en dernier recours.
stop_child() {
	if ! child_alive && ! group_alive; then
		CHILD=0
		return 0
	fi
	log "arrêt de Steam headless ($1)"
	if steam_running; then
		"$STEAM_BIN" -shutdown >/dev/null 2>&1 &
		local i
		for ((i = 0; i < STOP_TIMEOUT; i++)); do
			child_alive || break
			steam_running || break
			sleep 1
		done
	fi
	if child_alive || group_alive; then
		kill -TERM -- "-$CHILD" 2>/dev/null || true
		for ((i = 0; i < 10; i++)); do
			child_alive || group_alive || break
			sleep 0.5
		done
	fi
	if child_alive || group_alive; then
		log "gamescope ou Steam ne répond pas, SIGKILL"
		kill -KILL -- "-$CHILD" 2>/dev/null || true
	fi
	wait "$CHILD" 2>/dev/null || true
	sweep_cgroup
	CHILD=0
	log "Steam headless arrêté"
}

# Reste-t-il des processus dans le groupe du fils ?
group_alive() { ((CHILD > 0)) && pgrep -g "$CHILD" >/dev/null; }

# Filet de sécurité : sous systemd, tout processus restant dans le cgroup de
# steamd.service (hors ce superviseur) est un reste de Steam headless. En
# veille, le service reste actif et systemd ne ferait pas ce ménage.
sweep_cgroup() {
	local cg procs p n=0
	cg=$(sed -n 's/^0:://p' /proc/self/cgroup 2>/dev/null)
	[[ $cg == */steamd.service ]] || return 0
	procs="/sys/fs/cgroup$cg/cgroup.procs"
	[[ -r $procs ]] || return 0
	while read -r p; do
		[[ $p == "$$" || $p == "$BASHPID" ]] && continue
		# Ne pas tuer l'inhibiteur de veille, géré à part.
		((INHIBIT_PID > 0)) && [[ $(ps -o pgid= -p "$p" 2>/dev/null | tr -d ' ') == "$INHIBIT_PID" ]] && continue
		kill -KILL "$p" 2>/dev/null && n=$((n + 1))
	done <"$procs"
	((n == 0)) || log "$n processus restants terminés (SIGKILL)"
}

# --- État (lu par steamd-session-hook et steamd-doctor) ------------------------
STATE=""
set_state() {
	local new=$1 why=$2
	if [[ $new != "$STATE" ]]; then
		log "état : $new ($why)"
		STATE=$new
	fi
	printf '%s\n%s\n' "$new" "$why" >"$STATE_FILE.tmp" && mv -f "$STATE_FILE.tmp" "$STATE_FILE"
}

# --- Boucle principale --------------------------------------------------------
KICK=0
STOPPING=0
on_term() { STOPPING=1; }
on_usr1() { KICK=1; }

# Attente interruptible par SIGUSR1/SIGTERM.
nap() {
	((KICK || STOPPING)) && return 0
	sleep "$1" &
	local sp=$!
	wait "$sp" 2>/dev/null || true
	kill "$sp" 2>/dev/null || true
}

supervise() {
	local fails=0 delay=0 game="" name="" last_id="" last_game=0 desktop_waiting=0
	local idle=0 last_tick=$SECONDS dt
	trap on_term TERM INT
	trap on_usr1 USR1
	trap 'close_prompt; inhibit_off; set_state stopped "service arrêté"' EXIT
	log "configuration : $CONF ; politique de session : $DESKTOP_SESSION_POLICY ; inactivité : $IDLE_ACTION"

	while ((!STOPPING)); do
		KICK=0
		# Temps écoulé depuis le tour précédent. Un grand saut signifie une
		# sortie de veille : on remet le compteur d'inactivité à zéro.
		dt=$((SECONDS - last_tick))
		last_tick=$SECONDS
		((dt > POLL_INTERVAL * 3 + 10)) && idle=0 && dt=0

		# Fin inattendue du fils : on relance après un délai croissant.
		if ((CHILD > 0)) && ! child_alive; then
			local rc=0
			wait "$CHILD" 2>/dev/null || rc=$?
			# Des restes de Steam peuvent survivre à gamescope.
			kill -KILL -- "-$CHILD" 2>/dev/null || true
			sweep_cgroup
			CHILD=0
			inhibit_off
			if ((SECONDS - CHILD_STARTED < 60)); then fails=$((fails + 1)); else fails=1; fi
			delay=$((RESTART_DELAY * fails))
			((delay > 300)) && delay=300
			log "gamescope/Steam s'est terminé (code $rc), nouvelle tentative dans ${delay}s"
			set_state backoff "fin inattendue (code $rc), relance dans ${delay}s"
			nap "$delay"
			continue
		fi

		# Partie Remote Play en cours dans Steam headless ?
		game=""
		child_alive && game=$(headless_game)
		if [[ -n $game ]]; then
			[[ $game != "$last_id" ]] && name=$(game_name "$game") && last_id=$game
			last_game=$SECONDS
			idle=0
			inhibit_on "Partie Remote Play : $name"
		else
			inhibit_off
		fi

		if [[ $DESKTOP_SESSION_POLICY == yield ]] && local_graphical_session; then
			idle=0
			if child_alive && [[ -e $HANDOVER_FILE ]]; then
				# Passage de main demandé depuis le bureau (popup ou --handover).
				rm -f "$HANDOVER_FILE"
				close_prompt
				inhibit_off
				stop_child "passage de main demandé depuis le bureau${game:+, partie « $name » fermée}"
				set_state standby "session graphique locale ouverte : le Steam du bureau a la priorité"
				desktop_waiting=0
				resume_desktop_steam
			elif child_alive && [[ -n $game ]]; then
				# Session ouverte pendant une partie : on ne coupe rien.
				if ((!desktop_waiting)); then
					desktop_waiting=1
					log "session de bureau ouverte pendant la partie « $name » : elle continue"
					ask_handover "$name"
				fi
				set_state busy "session de bureau ouverte, partie Remote Play en cours ($name) : elle n'est pas interrompue"
			elif child_alive && ((desktop_waiting && SECONDS - last_game < HANDOVER_DELAY)); then
				# Laisse le temps d'enchaîner (relance du jeu, launcher...).
				set_state busy "partie terminée, passage au bureau dans $((HANDOVER_DELAY - (SECONDS - last_game)))s sauf nouvelle partie"
			else
				rm -f "$HANDOVER_FILE"
				close_prompt
				stop_child "session graphique locale ouverte"
				set_state standby "session graphique locale ouverte : le Steam du bureau a la priorité"
				if ((desktop_waiting)); then
					desktop_waiting=0
					resume_desktop_steam
				fi
			fi
		else
			desktop_waiting=0
			rm -f "$HANDOVER_FILE"
			close_prompt
			if child_alive; then
				if [[ -n $game ]]; then
					set_state running "partie Remote Play en cours : $name"
				else
					set_state running "Steam headless actif"
				fi
			elif steam_running; then
				set_state standby "un autre Steam tourne déjà pour $USER : il n'est pas interrompu"
			else
				start_child
				set_state running "Steam headless actif"
			fi

			# Inactivité : Steam headless sans partie et personne de connecté.
			if [[ $IDLE_ACTION != none && $STATE == running && -z $game ]] && (($(user_sessions) == 0)); then
				idle=$((idle + dt))
				if ((idle >= IDLE_TIMEOUT)); then
					log "aucune partie ni session depuis ${IDLE_TIMEOUT}s : $IDLE_ACTION"
					idle=0
					case $IDLE_ACTION in
					suspend) systemctl suspend || log "échec de la mise en veille (règle polkit installée ?)" ;;
					poweroff) systemctl poweroff || log "échec de l'extinction (règle polkit installée ?)" ;;
					esac
				fi
			else
				idle=0
			fi
		fi
		nap "$POLL_INTERVAL"
	done

	inhibit_off
	stop_child "arrêt du service"
}

case ${1:-} in
--print)
	load_conf
	validate_conf
	build_command
	printf '%q ' "${CMD[@]}"
	echo
	exit 0
	;;
--handover)
	mkdir -p "$RUNTIME_DIR"
	: >"$HANDOVER_FILE"
	systemctl --user kill --kill-whom=main -s USR1 steamd.service 2>/dev/null || true
	echo "Demande envoyée : Steam headless va être fermé et Steam ouvert sur le bureau."
	echo "(Sans effet si aucune session de bureau n'est ouverte ou si steamd est déjà en veille.)"
	exit 0
	;;
--status)
	if [[ -r $STATE_FILE ]]; then cat "$STATE_FILE"; else echo "inconnu"; fi
	exit 0
	;;
"") ;;
*) die $EXIT_CONFIG "option inconnue : $1 (attendu : --print, --status, --handover)" ;;
esac

load_conf
validate_conf
build_command
mkdir -p "$RUNTIME_DIR"
supervise
