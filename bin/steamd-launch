#!/usr/bin/env bash
# Lance gamescope headless + Steam Big Picture selon ~/.config/steamd/steamd.conf.
# Steam tourne avec un HOME dédié (STEAMD_HOME) : client distinct du Steam du bureau,
# qui peut tourner en parallèle. Seule la bibliothèque de jeux est partagée.
#   --stop                 arrêt propre de Steam (appelé par ExecStop)
#   --setup                même client en fenêtre dans la session de bureau (connexion, Remote Play, bibliothèque)
#   --profiles             profils d'affichage (défaut + CLIENT_PROFILES) et profil actif
#   --profile NOM          demande un profil (default ou première IP d'une entrée), appliqué hors partie
#   --profile-for IP...    nom du profil d'une de ces IP (utilisé par steamd-profiled)
#   --amf-path             runtime AMF trouvé (libamfrt64.so.1), ou paquet à installer (code 1)
set -euo pipefail

CONF="${XDG_CONFIG_HOME:-$HOME/.config}/steamd/steamd.conf"
WIDTH=1280 HEIGHT=800 REFRESH=60 STEAM_CAPTURE=pipewire-dmabuf
GAMESCOPE_EXTRA_ARGS="" STEAM_EXTRA_ARGS="" ENCODER="" VAAPI_STRICT_RC=false AMF_ENCODER=false
AUDIO_ISOLATE=false AUDIO_SINK=steamd
APP_WIDTH="" APP_HEIGHT="" HDR=false
CLIENT_PROFILES=()
STREAM_TUNING=true FPS_LIMIT=auto FPS_LIMIT_METHOD=mangohud FPS_LIMIT_TIMING=late
STEAM_ENV=()
STEAM_SETTINGS=()
NETWORK_WAIT=90 DESKTOP_STEAM=quit
STEAMD_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/steamd-home"
# shellcheck source=/dev/null
[[ -r $CONF ]] && source "$CONF"

log() { echo "steamd: $*" >&2; }

RUNDIR="${XDG_RUNTIME_DIR:-/run/user/$UID}/steamd"
PROFILE_FILE=$RUNDIR/profile          # profil actif, lu à chaque démarrage
PROFILE_REQUEST=$RUNDIR/profile.request  # demande de --profile, traitée par steamd-profiled

# --- Profils d'affichage ------------------------------------------------------
# Profil par défaut : WIDTH/HEIGHT (sortie), APP_WIDTH/APP_HEIGHT (rendu), REFRESH, HDR.
# CLIENT_PROFILES : "IP[,IP2] OUTPUT=LxH RENDER=LxH REFRESH=N HDR=true|false FPS_LIMIT=auto|N"
valid_num() { [[ $1 =~ ^[1-9][0-9]{0,4}$ ]] && (($1 <= 16384)); }

default_profile() {
    P_NAME=default P_W=$WIDTH P_H=$HEIGHT P_AW=${APP_WIDTH:-$WIDTH} P_AH=${APP_HEIGHT:-$HEIGHT}
    P_R=$REFRESH P_HDR=$HDR P_FPS=$FPS_LIMIT
}

# Remplit P_* depuis une entrée de CLIENT_PROFILES ; PARSE_ERROR en cas d'erreur
parse_profile() {
    local kv k v render=false
    local -a words
    read -ra words <<<"$1"
    PARSE_ERROR=""
    if ((${#words[@]} == 0)) || ! [[ ${words[0]} =~ ^[0-9A-Fa-f.:]+(,[0-9A-Fa-f.:]+)*$ ]]; then
        PARSE_ERROR="le premier mot doit être une IP (ou plusieurs, séparées par des virgules)"
        return 1
    fi
    default_profile
    P_NAME=${words[0]%%,*}
    for kv in "${words[@]:1}"; do
        k=${kv%%=*} v=${kv#*=}
        if [[ $kv != *=* ]]; then PARSE_ERROR="« $kv » n'est pas de la forme CLÉ=VALEUR"; return 1; fi
        case $k in
            OUTPUT | RENDER)
                local w="" h=""
                # valid_num refait un =~ : lire BASH_REMATCH avant
                if [[ $v =~ ^([0-9]+)x([0-9]+)$ ]]; then w=${BASH_REMATCH[1]} h=${BASH_REMATCH[2]}; fi
                if ! valid_num "$w" || ! valid_num "$h"; then
                    PARSE_ERROR="$k attend LARGEURxHAUTEUR (valeur : « $v »)"; return 1
                fi
                if [[ $k == OUTPUT ]]; then
                    P_W=$w P_H=$h
                else
                    P_AW=$w P_AH=$h render=true
                fi ;;
            REFRESH)
                valid_num "$v" || { PARSE_ERROR="REFRESH attend un entier (valeur : « $v »)"; return 1; }
                P_R=$v ;;
            HDR)
                [[ $v == true || $v == false ]] || { PARSE_ERROR="HDR attend true ou false (valeur : « $v »)"; return 1; }
                P_HDR=$v ;;
            FPS_LIMIT)
                [[ $v == auto || $v == 0 ]] || valid_num "$v" || { PARSE_ERROR="FPS_LIMIT attend auto, 0 ou un entier (valeur : « $v »)"; return 1; }
                P_FPS=$v ;;
            *) PARSE_ERROR="clé inconnue « $k » (OUTPUT, RENDER, REFRESH, HDR, FPS_LIMIT)"; return 1 ;;
        esac
    done
    # OUTPUT sans RENDER : le jeu est rendu à la résolution de sortie
    if ! $render && [[ $1 == *OUTPUT=* ]]; then P_AW=$P_W P_AH=$P_H; fi
}

# Active un profil par son nom : default ou première IP d'une entrée
select_profile() {
    local entry first
    if [[ $1 == default ]]; then default_profile; return 0; fi
    for entry in "${CLIENT_PROFILES[@]}"; do
        read -r first _ <<<"$entry"
        if [[ ,$first, == *",$1,"* ]]; then parse_profile "$entry"; return; fi
    done
    return 1
}

# Nom du profil d'une des IP données, ou rien
profile_for_ips() {
    local ip entry first
    for entry in "${CLIENT_PROFILES[@]}"; do
        read -r first _ <<<"$entry"
        for ip in "$@"; do
            if [[ ,$first, == *",$ip,"* ]]; then echo "${first%%,*}"; return 0; fi
        done
    done
}

# Conf invalide : code 2, que systemd ne relance pas
check_profiles() {
    local v entry
    for v in WIDTH HEIGHT REFRESH; do
        valid_num "${!v}" || { log "$v invalide dans $CONF : « ${!v} »"; exit 2; }
    done
    for v in APP_WIDTH APP_HEIGHT; do
        [[ -z ${!v} ]] || valid_num "${!v}" || { log "$v invalide dans $CONF : « ${!v} »"; exit 2; }
    done
    [[ $NETWORK_WAIT == 0 ]] || valid_num "$NETWORK_WAIT" || { log "NETWORK_WAIT invalide : « $NETWORK_WAIT » (secondes, 0 = pas d'attente)"; exit 2; }
    [[ $HDR == true || $HDR == false ]] || { log "HDR invalide dans $CONF : « $HDR » (true ou false)"; exit 2; }
    [[ $STREAM_TUNING == true || $STREAM_TUNING == false ]] || { log "STREAM_TUNING invalide : « $STREAM_TUNING » (true ou false)"; exit 2; }
    [[ $AMF_ENCODER == true || $AMF_ENCODER == false ]] || { log "AMF_ENCODER invalide : « $AMF_ENCODER » (true ou false)"; exit 2; }
    [[ $FPS_LIMIT == auto || $FPS_LIMIT == 0 ]] || valid_num "$FPS_LIMIT" || { log "FPS_LIMIT invalide : « $FPS_LIMIT » (auto, 0 ou un entier)"; exit 2; }
    [[ $FPS_LIMIT_METHOD == mangohud || $FPS_LIMIT_METHOD == dxvk ]] || { log "FPS_LIMIT_METHOD invalide : « $FPS_LIMIT_METHOD » (mangohud ou dxvk)"; exit 2; }
    [[ $FPS_LIMIT_TIMING == late || $FPS_LIMIT_TIMING == early ]] || { log "FPS_LIMIT_TIMING invalide : « $FPS_LIMIT_TIMING » (late ou early)"; exit 2; }
    for entry in "${STEAM_SETTINGS[@]}"; do
        [[ $entry =~ ^[^:=]+:[^=]+= ]] || { log "STEAM_SETTINGS : « $entry » n'est pas de la forme FICHIER:CLÉ=VALEUR"; exit 2; }
    done
    for entry in "${STEAM_ENV[@]}"; do
        [[ $entry =~ ^[A-Za-z_][A-Za-z0-9_]*= ]] || { log "STEAM_ENV : « $entry » n'est pas de la forme NOM=valeur"; exit 2; }
    done
    for entry in "${CLIENT_PROFILES[@]}"; do
        parse_profile "$entry" || { log "CLIENT_PROFILES : « $entry » : $PARSE_ERROR"; exit 2; }
    done
}

print_profile() {
    printf '%-16s sortie %sx%s, rendu %sx%s, %s Hz, HDR %s, limite %s i/s\n' \
        "$P_NAME" "$P_W" "$P_H" "$P_AW" "$P_AH" "$P_R" "$P_HDR" "$(fps_of "$P_FPS")"
}
fps_of() { if [[ $1 == auto ]]; then echo "$P_R"; else echo "$1"; fi; }

# Runtime AMF de l'hôte (AMF_ENCODER) : cache de ld.so, puis emplacements des paquets d'AMD,
# qui ne le déclarent pas toujours à ld.so
AMF_DIRS=${STEAMD_AMF_DIRS:-/usr/lib /usr/lib64 /usr/lib/x86_64-linux-gnu /opt/amdgpu-pro/lib64 /opt/amdgpu-pro/lib/x86_64-linux-gnu /opt/amdgpu/lib64 /opt/amdgpu/lib/x86_64-linux-gnu}
find_amf_lib() {
    local f d
    f=$(${STEAMD_LDCONFIG:-ldconfig} -p 2>/dev/null | awk -v n="$1" '$1 == n && /x86-64/ {print $NF; exit}')
    if [[ -n $f && -e $f ]]; then echo "$f"; return 0; fi
    for d in $AMF_DIRS; do
        if [[ -e $d/$1 ]]; then echo "$d/$1"; return 0; fi
    done
    return 1
}
find_amf() {
    if [[ -n ${STEAMD_AMF_RT:-} ]]; then [[ -e $STEAMD_AMF_RT ]] && echo "$STEAMD_AMF_RT"; return; fi
    find_amf_lib libamfrt64.so.1
}
# Paquet du runtime AMF selon la distribution
amf_hint() {
    local ID="" ID_LIKE=""
    # shellcheck source=/dev/null
    [[ -r ${STEAMD_OS_RELEASE:-/etc/os-release} ]] && source "${STEAMD_OS_RELEASE:-/etc/os-release}"
    case " $ID $ID_LIKE " in
        *" arch "*)                echo "paquet AUR amf-amdgpu-pro" ;;
        *" ubuntu "*|*" debian "*) echo "pilote AMD pour Ubuntu : amdgpu-install --usecase=amf" ;;
        *" fedora "*|*" rhel "*|*" suse "*) echo "dépôt AMD (amdgpu-install --usecase=amf), paquet amf-amdgpu-pro" ;;
        *)                         echo "runtime AMF d'AMD (paquet amf-amdgpu-pro de son pilote)" ;;
    esac
}

case ${1:-} in
    --amf-path)
        if find_amf; then exit 0; fi
        echo "libamfrt64.so.1 introuvable : $(amf_hint)" >&2
        exit 1 ;;
    --profiles)
        check_profiles
        default_profile; print_profile
        for entry in "${CLIENT_PROFILES[@]}"; do parse_profile "$entry"; print_profile; done
        echo "actif : $(cat "$PROFILE_FILE" 2>/dev/null || echo default)"
        [[ -s $PROFILE_REQUEST ]] && echo "demandé : $(head -n1 "$PROFILE_REQUEST") (appliqué hors partie)"
        exit 0 ;;
    --profile)
        check_profiles
        [[ -n ${2:-} ]] && select_profile "$2" || { log "profil inconnu : « ${2:-} » (default ou première IP d'une entrée de CLIENT_PROFILES)"; exit 2; }
        mkdir -p "$RUNDIR"
        echo "$2" >"$PROFILE_REQUEST"
        echo "profil $2 demandé : steamd-profiled l'applique hors partie (Steam headless redémarre)"
        exit 0 ;;
    --profile-for)
        shift
        profile_for_ips "$@"
        exit 0 ;;
esac

# steamd-steamcfg, à côté de ce script
STEAMCFG="$(dirname "$(readlink -f "$0")")/steamd-steamcfg"
STEAMD_HOME=$(readlink -m "$STEAMD_HOME")

# Bibliothèques LD_PRELOAD (src/), cherchées avant le changement de HOME
SYSLIBDIR=${STEAMD_SYSLIBDIR:-/usr/lib/steamd}
vaapi_lib=""
for f in "${XDG_DATA_HOME:-$HOME/.local/share}/steamd/libsteamd-vaapi.so" "$SYSLIBDIR/libsteamd-vaapi.so"; do
    [[ -r $f ]] && { vaapi_lib=$f; break; }
done
amf_lib=""
for f in "${XDG_DATA_HOME:-$HOME/.local/share}/steamd/libsteamd-amf.so" "$SYSLIBDIR/libsteamd-amf.so"; do
    [[ -r $f ]] && { amf_lib=$f; break; }
done

# Environnement du Steam du bureau, pour le fermer après le changement de HOME
DESKTOP_HOME=$HOME
desktop_env=(env -u DISPLAY -u WAYLAND_DISPLAY -u XDG_CONFIG_HOME -u XDG_DATA_HOME -u XDG_CACHE_HOME HOME="$HOME")
for v in XDG_CONFIG_HOME XDG_DATA_HOME XDG_CACHE_HOME; do [[ -n ${!v:-} ]] && desktop_env+=("$v=${!v}"); done

mkdir -p "$STEAMD_HOME"
export HOME=$STEAMD_HOME STEAMD_HOME
export XDG_CONFIG_HOME=$HOME/.config XDG_DATA_HOME=$HOME/.local/share XDG_CACHE_HOME=$HOME/.cache

# Réglages Steam de STEAM_SETTINGS ("FICHIER:CLÉ=VALEUR"), écrits Steam fermé.
# Clés relevées avec steamd-steamcfg snapshot / diff ; un échec n'empêche pas le démarrage.
apply_settings() {
    ((${#STEAM_SETTINGS[@]})) || return 0
    if ! command -v python3 >/dev/null; then
        log "STEAM_SETTINGS ignoré : python3 introuvable (sudo pacman -S python)"
        return 0
    fi
    python3 "$STEAMCFG" apply "${STEAM_SETTINGS[@]}" 2>&1 | sed 's/^/steamd: /' >&2 ||
        log "STEAM_SETTINGS : application incomplète (steamd-steamcfg apply)"
}

# Encodeur Remote Play (option « Activer l'encodage matériel ») : réglé avant le démarrage de Steam
set_encoder() {
    local val vdf found=false
    case $ENCODER in
        "")       return ;;
        hardware) val=1 ;;
        software) val=0 ;;
        *) log "ENCODER invalide : $ENCODER"; exit 2 ;;
    esac
    for vdf in "$XDG_DATA_HOME"/Steam/userdata/*/config/localconfig.vdf; do
        [[ -f $vdf ]] || continue
        if grep -q '"EnableHardwareEncoding"' "$vdf"; then
            sed -i -E 's/^(\s*"EnableHardwareEncoding"\s+)"[01]"/\1"'"$val"'"/' "$vdf"
            found=true
        fi
    done
    $found || log "EnableHardwareEncoding absent : basculer l'option une fois dans l'UI (steamd-launch --setup)"
}

case ${1:-} in
    --stop)
        # Steam déjà mort (processus tués) : steam -shutdown en lancerait un complet,
        # sur l'écran du bureau si la session a exporté DISPLAY dans systemd
        if [[ -n ${MAINPID:-} ]] && ! kill -0 "$MAINPID" 2>/dev/null; then exit 0; fi
        pgrep -u "$UID" -f "$HOME/.local/share/Steam/" >/dev/null || exit 0
        env -u DISPLAY -u WAYLAND_DISPLAY steam -shutdown >/dev/null 2>&1 || true
        for _ in $(seq 40); do
            [[ -n ${MAINPID:-} ]] && kill -0 "$MAINPID" 2>/dev/null || exit 0
            sleep 1
        done
        log "Steam ne s'est pas arrêté, systemd termine les processus"
        exit 0 ;;
    --setup)
        if systemctl --user -q is-active steamd.service; then
            log "arrêter d'abord le service : systemctl --user stop steamd"
            exit 1
        fi
        check_profiles
        set_encoder
        apply_settings
        log "client steamd en fenêtre (HOME=$HOME) ; le fermer complètement à la fin"
        exec steam ;;
esac

# Au boot (linger), le service part avant le réseau : Steam démarrerait hors ligne,
# sans s'annoncer sur le réseau local
wait_network() {
    local i
    for ((i = 0; i < NETWORK_WAIT; i++)); do
        # Route par une interface physique : un VPN (gpd0, wg0, tun0...) ne sert pas à la découverte locale
        ip -4 route show default 2>/dev/null | grep -qvE 'dev (lo|tun|tap|wg|gpd|ppp|tailscale|zt)' && { ((i == 0)) || log "réseau prêt après $i s"; return 0; }
        ((i == 0)) && log "attente du réseau (route par défaut, $NETWORK_WAIT s au plus)"
        sleep 1
    done
    ((NETWORK_WAIT == 0)) || log "pas de réseau après $NETWORK_WAIT s, démarrage quand même"
}

# Port de découverte déjà pris (Steam du bureau) : le Deck ne verrait pas steamd
check_ports() {
    local held
    held=$(ss -Hulnp '( sport = :27036 )' 2>/dev/null | grep -o 'pid=[0-9]*' | cut -d= -f2 | sort -u) || return 0
    [[ -n $held ]] || return 0
    log "port UDP 27036 déjà tenu par $(ps -o pid=,args= -p "${held//$'\n'/,}" 2>/dev/null | cut -c1-80 | paste -sd';')"
    log "→ fermer le Steam du bureau, puis systemctl --user restart steamd"
}

# Steam du bureau lancé avant steamd (autologin, session restaurée) : il garde le port 27036
# même Remote Play coupé. Fermé au premier démarrage après le boot seulement ($RUNDIR est
# vidé au boot) : un Steam du bureau relancé ensuite à la main n'est plus touché.
quit_desktop_steam() {
    local mark=$RUNDIR/desktop-steam-checked pat="$DESKTOP_HOME/.local/share/Steam/" i
    [[ $DESKTOP_STEAM == quit && ! -e $mark ]] || return 0
    mkdir -p "$RUNDIR" && : >"$mark"
    pgrep -u "$UID" -f "$pat" >/dev/null || return 0
    log "Steam du bureau lancé avant steamd : fermeture (DESKTOP_STEAM=keep pour le garder)"
    "${desktop_env[@]}" steam -shutdown >/dev/null 2>&1 || true
    for ((i = 0; i < 30; i++)); do
        pgrep -u "$UID" -f "$pat" >/dev/null || return 0
        ((i == 20)) && pkill -u "$UID" -f "$pat"
        sleep 1
    done
    log "Steam du bureau toujours là, le port 27036 risque d'être pris"
}

check_profiles
set_encoder
apply_settings
wait_network
quit_desktop_steam
check_ports

active=$(cat "$PROFILE_FILE" 2>/dev/null || echo default)
if ! select_profile "$active"; then
    log "profil actif « $active » absent de CLIENT_PROFILES, profil par défaut"
    default_profile
    rm -f "$PROFILE_FILE"
fi
log "profil $(print_profile)"

# Le client Steam tourne dans le conteneur du runtime : la bibliothèque doit être sous son HOME
if [[ $VAAPI_STRICT_RC == true ]]; then
    if [[ -z $vaapi_lib ]]; then
        log "VAAPI_STRICT_RC : libsteamd-vaapi.so introuvable (réinstaller steamd)"
    else
        install -Dm644 "$vaapi_lib" "$HOME/.local/lib/steamd/libsteamd-vaapi.so"
        export LD_PRELOAD="$HOME/.local/lib/steamd/libsteamd-vaapi.so${LD_PRELOAD:+:$LD_PRELOAD}"
        export STEAMD_VA_FPS=$P_R STEAMD_VA_DEBUG=1
        if [[ $ENCODER == software ]]; then log "VAAPI_STRICT_RC sans effet avec ENCODER=software"; fi
    fi
fi

# Encodeur AMF de Steam, seul chemin AV1 sur GPU AMD (src/steamd-amf.c)
if [[ $AMF_ENCODER == true ]]; then
    amf_rt=$(find_amf) || amf_rt=""
    if [[ -z $amf_lib ]]; then
        log "AMF_ENCODER : libsteamd-amf.so introuvable (réinstaller steamd)"
    elif [[ -z $amf_rt ]]; then
        log "AMF_ENCODER : AMF absent (libamfrt64.so.1 ; $(amf_hint)), encodeur VA-API"
    else
        # libamdenc64 est d'ordinaire à côté de libamfrt64
        amf_dirs=${amf_rt%/*}
        if amf_enc=$(find_amf_lib libamdenc64.so.1.0) && [[ ${amf_enc%/*} != "$amf_dirs" ]]; then
            amf_dirs+=":${amf_enc%/*}"
        fi
        log "AMF : $amf_rt"
        install -Dm644 "$amf_lib" "$HOME/.local/lib/steamd/libsteamd-amf.so"
        export LD_PRELOAD="$HOME/.local/lib/steamd/libsteamd-amf.so${LD_PRELOAD:+:$LD_PRELOAD}"
        export STEAMD_AMF_DIR=$amf_dirs STEAMD_AMF_DEBUG=1
        if [[ $ENCODER == software ]]; then log "AMF_ENCODER sans effet avec ENCODER=software"; fi
    fi
fi

# Sortie audio dédiée : Remote Play ne capture plus le son du bureau, et le jeu ne sort plus sur le PC
if [[ $AUDIO_ISOLATE == true ]]; then
    if ! [[ $AUDIO_SINK =~ ^[A-Za-z0-9_.-]+$ ]]; then
        log "AUDIO_SINK invalide dans $CONF : « $AUDIO_SINK »"
        exit 2
    fi
    if ! command -v pactl >/dev/null; then
        log "AUDIO_ISOLATE : pactl introuvable (sudo pacman -S libpulse), son non isolé"
    else
        sinks=$(pactl list short sinks 2>/dev/null) || sinks=""
        if awk -v n="$AUDIO_SINK" '$2 == n {f = 1} END {exit !f}' <<<"$sinks"; then
            export PULSE_SINK=$AUDIO_SINK PULSE_SOURCE=$AUDIO_SINK.monitor
        else
            default=$(pactl get-default-sink 2>/dev/null) || default=""
            if pactl load-module module-null-sink sink_name="$AUDIO_SINK" \
                sink_properties=device.description="$AUDIO_SINK" >/dev/null 2>&1; then
                # La nouvelle sortie ne doit pas devenir celle du bureau
                if [[ -n $default && $(pactl get-default-sink 2>/dev/null) == "$AUDIO_SINK" ]]; then
                    pactl set-default-sink "$default" || true
                fi
                log "sortie audio $AUDIO_SINK créée"
                export PULSE_SINK=$AUDIO_SINK PULSE_SOURCE=$AUDIO_SINK.monitor
            else
                log "AUDIO_ISOLATE : création de la sortie $AUDIO_SINK impossible (PipeWire joignable ?), son non isolé"
            fi
        fi
    fi
fi

case $STEAM_CAPTURE in
    pipewire-dmabuf) capture=(-pipewire-dmabuf) ;;
    pipewire)        capture=(-pipewire) ;;
    none)            capture=() ;;
    *) log "STEAM_CAPTURE invalide : $STEAM_CAPTURE"; exit 2 ;;
esac

eval "gs_extra=($GAMESCOPE_EXTRA_ARGS)"
eval "steam_extra=($STEAM_EXTRA_ARGS)"

# Environnement des jeux de Steam headless (le Steam du bureau n'est pas concerné).
# Les options de lancement d'un jeu (VAR=... %command%) restent prioritaires.
hdr_gs=() envs=()
if [[ $STREAM_TUNING == true ]]; then
    # Une seule image préparée d'avance au lieu de 3 : moins de latence
    envs+=("DXVK_CONFIG=dxgi.maxFrameLatency=1;d3d9.maxFrameLatency=1")
    # Proton-CachyOS : variantes « low latency » de DXVK et VKD3D-Proton (ignorées ailleurs)
    envs+=(PROTON_DXVK_LOWLATENCY=1 PROTON_VKD3D_LOWLATENCY=1)
    # Anti-Lag d'AMD fourni par Mesa (couche Vulkan), ignoré si absent
    envs+=(ENABLE_LAYER_MESA_ANTI_LAG=1)
fi
fps=$(fps_of "$P_FPS")
if ((fps > 0)); then
    method=$FPS_LIMIT_METHOD
    if [[ $method == mangohud ]] && ! compgen -G '/usr/share/vulkan/implicit_layer.d/MangoHud*.json' >/dev/null; then
        log "MangoHud absent (sudo pacman -S mangohud) : limite via DXVK et VKD3D-Proton (jeux Windows sous Proton)"
        method=dxvk
    fi
    case $method in
        mangohud) envs+=(MANGOHUD=1 "MANGOHUD_CONFIG=fps_limit=$fps,fps_limit_method=$FPS_LIMIT_TIMING,no_display") ;;
        dxvk)     envs+=("DXVK_FRAME_RATE=$fps" "VKD3D_FRAME_RATE=$fps") ;;
    esac
fi
if [[ $P_HDR == true ]]; then hdr_gs=(--hdr-enabled) envs+=(DXVK_HDR=1); fi
# Variables de l'utilisateur en dernier : elles l'emportent
envs+=("${STEAM_ENV[@]}")
game_env=()
((${#envs[@]} == 0)) || game_env=(env "${envs[@]}")

cmd=(gamescope -W "$P_W" -H "$P_H" -w "$P_AW" -h "$P_AH" -r "$P_R"
     --backend headless --steam "${hdr_gs[@]}" "${gs_extra[@]}" --
     "${game_env[@]}" steam -tenfoot "${capture[@]}" "${steam_extra[@]}")
log "${cmd[*]}"
exec "${cmd[@]}"
