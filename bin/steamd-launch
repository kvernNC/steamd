#!/usr/bin/env bash
# Lance gamescope headless + Steam Big Picture selon ~/.config/steamd/steamd.conf.
# Steam tourne avec un HOME dédié (STEAMD_HOME) : client distinct du Steam du bureau,
# qui peut tourner en parallèle. Seule la bibliothèque de jeux est partagée.
#   --stop   arrêt propre de Steam (appelé par ExecStop)
#   --setup  même client en fenêtre dans la session de bureau (connexion, Remote Play, bibliothèque)
set -euo pipefail

CONF="${XDG_CONFIG_HOME:-$HOME/.config}/steamd/steamd.conf"
WIDTH=1280 HEIGHT=800 REFRESH=60 STEAM_CAPTURE=pipewire-dmabuf
GAMESCOPE_EXTRA_ARGS="" STEAM_EXTRA_ARGS="" ENCODER="" VAAPI_STRICT_RC=false
AUDIO_ISOLATE=false AUDIO_SINK=steamd
STEAMD_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/steamd-home"
# shellcheck source=/dev/null
[[ -r $CONF ]] && source "$CONF"

log() { echo "steamd: $*" >&2; }

# Bibliothèque de contrôle de débit VA-API (src/steamd-vaapi.c), cherchée avant le changement de HOME
vaapi_lib=""
for f in "${XDG_DATA_HOME:-$HOME/.local/share}/steamd/libsteamd-vaapi.so" /usr/lib/steamd/libsteamd-vaapi.so; do
    [[ -r $f ]] && { vaapi_lib=$f; break; }
done

mkdir -p "$STEAMD_HOME"
export HOME=$STEAMD_HOME
export XDG_CONFIG_HOME=$HOME/.config XDG_DATA_HOME=$HOME/.local/share XDG_CACHE_HOME=$HOME/.cache

# Encodeur Remote Play (option « Activer l'encodage matériel ») : réglé avant le démarrage de Steam
set_encoder() {
    local val vdf found=false
    case $ENCODER in
        "")       return ;;
        hardware) val=1 ;;
        software) val=0 ;;
        *) log "ENCODER invalide : $ENCODER"; exit 2 ;;
    esac
    for vdf in "$XDG_DATA_HOME"/Steam/userdata/*/config/localconfig.vdf; do
        [[ -f $vdf ]] || continue
        if grep -q '"EnableHardwareEncoding"' "$vdf"; then
            sed -i -E 's/^(\s*"EnableHardwareEncoding"\s+)"[01]"/\1"'"$val"'"/' "$vdf"
            found=true
        fi
    done
    $found || log "EnableHardwareEncoding absent : basculer l'option une fois dans l'UI (steamd-launch --setup)"
}

case ${1:-} in
    --stop)
        steam -shutdown >/dev/null 2>&1 || true
        for _ in $(seq 40); do
            [[ -n ${MAINPID:-} ]] && kill -0 "$MAINPID" 2>/dev/null || exit 0
            sleep 1
        done
        log "Steam ne s'est pas arrêté, systemd termine les processus"
        exit 0 ;;
    --setup)
        if systemctl --user -q is-active steamd.service; then
            log "arrêter d'abord le service : systemctl --user stop steamd"
            exit 1
        fi
        set_encoder
        log "client steamd en fenêtre (HOME=$HOME) ; le fermer complètement à la fin"
        exec steam ;;
esac

set_encoder

# Le client Steam tourne dans le conteneur du runtime : la bibliothèque doit être sous son HOME
if [[ $VAAPI_STRICT_RC == true ]]; then
    if [[ -z $vaapi_lib ]]; then
        log "VAAPI_STRICT_RC : libsteamd-vaapi.so introuvable (réinstaller steamd)"
    else
        install -Dm644 "$vaapi_lib" "$HOME/.local/lib/steamd/libsteamd-vaapi.so"
        export LD_PRELOAD="$HOME/.local/lib/steamd/libsteamd-vaapi.so${LD_PRELOAD:+:$LD_PRELOAD}"
        export STEAMD_VA_FPS=$REFRESH STEAMD_VA_DEBUG=1
        if [[ $ENCODER == software ]]; then log "VAAPI_STRICT_RC sans effet avec ENCODER=software"; fi
    fi
fi

# Sortie audio dédiée : Remote Play ne capture plus le son du bureau, et le jeu ne sort plus sur le PC
if [[ $AUDIO_ISOLATE == true ]]; then
    if ! [[ $AUDIO_SINK =~ ^[A-Za-z0-9_.-]+$ ]]; then
        log "AUDIO_SINK invalide dans $CONF : « $AUDIO_SINK »"
        exit 2
    fi
    if ! command -v pactl >/dev/null; then
        log "AUDIO_ISOLATE : pactl introuvable (sudo pacman -S libpulse), son non isolé"
    else
        sinks=$(pactl list short sinks 2>/dev/null) || sinks=""
        if awk -v n="$AUDIO_SINK" '$2 == n {f = 1} END {exit !f}' <<<"$sinks"; then
            export PULSE_SINK=$AUDIO_SINK PULSE_SOURCE=$AUDIO_SINK.monitor
        else
            default=$(pactl get-default-sink 2>/dev/null) || default=""
            if pactl load-module module-null-sink sink_name="$AUDIO_SINK" \
                sink_properties=device.description="$AUDIO_SINK" >/dev/null 2>&1; then
                # La nouvelle sortie ne doit pas devenir celle du bureau
                if [[ -n $default && $(pactl get-default-sink 2>/dev/null) == "$AUDIO_SINK" ]]; then
                    pactl set-default-sink "$default" || true
                fi
                log "sortie audio $AUDIO_SINK créée"
                export PULSE_SINK=$AUDIO_SINK PULSE_SOURCE=$AUDIO_SINK.monitor
            else
                log "AUDIO_ISOLATE : création de la sortie $AUDIO_SINK impossible (PipeWire joignable ?), son non isolé"
            fi
        fi
    fi
fi

for v in WIDTH HEIGHT REFRESH; do
    if ! [[ ${!v} =~ ^[1-9][0-9]{0,4}$ ]] || ((${!v} > 16384)); then
        log "$v invalide dans $CONF : « ${!v} »"
        exit 2
    fi
done

case $STEAM_CAPTURE in
    pipewire-dmabuf) capture=(-pipewire-dmabuf) ;;
    pipewire)        capture=(-pipewire) ;;
    none)            capture=() ;;
    *) log "STEAM_CAPTURE invalide : $STEAM_CAPTURE"; exit 2 ;;
esac

eval "gs_extra=($GAMESCOPE_EXTRA_ARGS)"
eval "steam_extra=($STEAM_EXTRA_ARGS)"

cmd=(gamescope -W "$WIDTH" -H "$HEIGHT" -w "$WIDTH" -h "$HEIGHT" -r "$REFRESH"
     --backend headless --steam "${gs_extra[@]}" --
     steam -tenfoot "${capture[@]}" "${steam_extra[@]}")
log "${cmd[*]}"
exec "${cmd[@]}"
