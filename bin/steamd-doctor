#!/usr/bin/env bash
# Diagnostic steamd : chaque point OK/KO avec une piste de correction.
set -uo pipefail

ko=0
ok()  { printf '\e[32m[OK]\e[0m %s\n' "$1"; }
bad() { printf '\e[31m[KO]\e[0m %s\n     → %s\n' "$1" "$2"; ko=$((ko + 1)); }
warn() { printf '\e[33m[ATTENTION]\e[0m %s\n     → %s\n' "$1" "$2"; }
info() { printf '[INFO] %s\n' "$1"; }
check() { local msg=$1 fix=$2; shift 2; if "$@" >/dev/null 2>&1; then ok "$msg"; else bad "$msg" "$fix"; fi; }

CONF="${XDG_CONFIG_HOME:-$HOME/.config}/steamd/steamd.conf"
STEAMD_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/steamd-home"
CLIENT_PROFILES=()
REFRESH=60 STREAM_TUNING=true FPS_LIMIT=auto FPS_LIMIT_METHOD=mangohud
STEAM_SETTINGS=()
# shellcheck source=/dev/null
[[ -r $CONF ]] && source "$CONF"

echo "== Binaires"
check "gamescope installé ($(gamescope --version 2>&1 | head -n1))" "sudo pacman -S gamescope" command -v gamescope
check "steam installé" "sudo pacman -S steam" command -v steam

echo "== Configuration"
check "configuration $CONF" "relancer ./install.sh ou copier config/steamd.conf.example" test -r "$CONF"
check "client steamd connecté ($STEAMD_HOME)" "steamd-launch --setup, depuis la session de bureau" \
    test -s "$STEAMD_HOME/.local/share/Steam/config/loginusers.vdf"

echo "== Linger"
check "linger activé" "loginctl enable-linger $USER" \
    bash -c '[[ $(loginctl show-user "$USER" -p Linger --value) == yes ]]'

echo "== PipeWire"
for u in pipewire.socket pipewire-pulse.socket wireplumber.service; do
    check "$u activé" "systemctl --user enable --now $u" systemctl --user -q is-enabled "$u"
done
for u in pipewire.service wireplumber.service; do
    check "$u actif" "systemctl --user start $u ; journalctl --user -u $u" systemctl --user -q is-active "$u"
done

echo "== GPU"
shopt -s nullglob
render=(/dev/dri/renderD*)
if ((${#render[@]} == 0)); then
    bad "nœud /dev/dri/renderD*" "pilote amdgpu non chargé ? lsmod | grep amdgpu"
fi
for n in "${render[@]}"; do
    check "lecture/écriture $n" "ls -l $n ; ajouter $USER au groupe render" test -r "$n" -a -w "$n"
done

echo "== Entrées (uinput)"
check "/dev/uinput présent" "sudo modprobe uinput ; vérifier /etc/modules-load.d/steamd-uinput.conf" test -c /dev/uinput
check "/dev/uinput appartient au groupe input" "règle /etc/udev/rules.d/60-steamd-uinput.rules puis sudo udevadm trigger" \
    bash -c '[[ $(stat -c %G /dev/uinput) == input ]]'
check "$USER membre du groupe input" "sudo usermod -aG input $USER" \
    bash -c 'id -nG "$USER" | tr " " "\n" | grep -qx input'
mgr=$(pgrep -u "$UID" -xo systemd)
gid=$(getent group input | cut -d: -f3)
check "gestionnaire systemd utilisateur dans le groupe input" "redémarrer le PC (le groupe n'est pris en compte qu'au prochain démarrage du gestionnaire)" \
    bash -c "grep '^Groups:' /proc/${mgr:-0}/status | tr -s ' \t' '\n' | grep -qx '${gid:-x}'"

echo "== Service"
check "steamd.service activé" "systemctl --user enable steamd.service" systemctl --user -q is-enabled steamd.service
check "steamd.service actif" "journalctl --user -u steamd -e" systemctl --user -q is-active steamd.service
launch=$(command -v steamd-launch || echo "$(dirname "$(readlink -f "$0")")/steamd-launch")
check "profils d'affichage valides" "journalctl --user -u steamd -e (ligne CLIENT_PROFILES ou valeur invalide)" "$launch" --profiles
"$launch" --profiles 2>/dev/null | sed 's/^/     /'
if ((${#CLIENT_PROFILES[@]})); then
    check "steamd-profiled.service actif (CLIENT_PROFILES)" "systemctl --user enable --now steamd-profiled.service" \
        systemctl --user -q is-active steamd-profiled.service
fi
if [[ ${AUDIO_ISOLATE:-false} == true ]]; then
    sink=${AUDIO_SINK:-steamd}
    check "sortie audio $sink présente (AUDIO_ISOLATE)" "systemctl --user restart steamd ; pactl list short sinks" \
        bash -c 'pactl list short sinks | awk "{print \$2}" | grep -qx "$1"' _ "$sink"
    check "sortie audio du bureau différente de $sink" "pactl set-default-sink <ta sortie>" \
        bash -c '[[ $(pactl get-default-sink) != "$1" ]]' _ "$sink"
    sp=$(pgrep -u "$UID" -x steam | head -n1)
    check "Steam de steamd envoyé sur $sink" "systemctl --user restart steamd" \
        bash -c 'tr "\0" "\n" < "/proc/$1/environ" | grep -qx "PULSE_SINK=$2"' _ "${sp:-0}" "$sink"
fi
if [[ ${VAAPI_STRICT_RC:-false} == true ]]; then
    sp=$(pgrep -u "$UID" -x steam | head -n1)
    check "libsteamd-vaapi chargée dans Steam (VAAPI_STRICT_RC)" "le runtime Steam a peut-être retiré LD_PRELOAD : journalctl --user -u steamd | grep steamd-vaapi" \
        grep -q libsteamd-vaapi "/proc/${sp:-0}/maps"
fi

echo "== Jeux de Steam headless"
if [[ $STREAM_TUNING == true ]]; then
    ok "optimisations stream actives (DXVK maxFrameLatency=1, DXVK/VKD3D low latency de Proton-CachyOS, Anti-Lag Mesa)"
    if compgen -G '/usr/share/vulkan/implicit_layer.d/*[Aa]nti*[Ll]ag*.json' >/dev/null; then
        ok "couche Anti-Lag de Mesa installée"
    else
        info "couche Anti-Lag de Mesa absente (Mesa trop ancien ?) : ENABLE_LAYER_MESA_ANTI_LAG sans effet"
    fi
    if [[ -e /dev/ntsync ]]; then
        if [[ -r /dev/ntsync && -w /dev/ntsync ]]; then
            ok "/dev/ntsync accessible"
        else
            warn "/dev/ntsync présent mais inaccessible ($(stat -c '%A %U:%G' /dev/ntsync)) : Proton n'utilisera pas ntsync" \
                "règle udev : KERNEL==\"ntsync\", MODE=\"0666\""
        fi
    elif [[ -d /sys/module/ntsync ]] || modinfo ntsync >/dev/null 2>&1; then
        warn "module ntsync disponible mais non chargé" "echo ntsync | sudo tee /etc/modules-load.d/ntsync.conf && sudo modprobe ntsync"
    else
        info "ntsync indisponible avec ce noyau : Proton utilisera fsync/esync"
    fi
    # Versions de Proton visibles du client steamd : quelle variable pilote ntsync ?
    declare -A seen=()
    for d in /usr/share/steam/compatibilitytools.d/* \
        "$STEAMD_HOME/.local/share/Steam/compatibilitytools.d/"* \
        "$STEAMD_HOME/.local/share/Steam/steamapps/common/Proton"* \
        "$HOME/.local/share/Steam/steamapps/common/Proton"*; do
        [[ -f $d/proton ]] || continue
        rd=$(readlink -f "$d")
        [[ -n ${seen[$rd]:-} ]] && continue
        seen[$rd]=1
        vars=$(grep -ohE '(PROTON|WINE)_[A-Z_]*NTSYNC[A-Z_]*' "$d/proton" 2>/dev/null | sort -u | paste -sd' ')
        enable="" disable=""
        for v in $vars; do
            if [[ $v == *DISABLE* || $v == *NO_NTSYNC* ]]; then disable+=" $v"; else enable+=" $v"; fi
        done
        if [[ -n $enable ]]; then
            warn "$(basename "$d") : ntsync activé par${enable}" "ajouter dans steamd.conf : STEAM_ENV=(\"${enable# }=1\")"
        elif [[ -n $disable ]]; then
            ok "$(basename "$d") : ntsync actif par défaut (désactivable par${disable})"
        else
            info "$(basename "$d") : pas de variable ntsync dans son script (activation automatique, ou non géré)"
        fi
    done
    # Pendant une partie : le wineserver a-t-il /dev/ntsync ouvert ?
    for wp in $(pgrep -u "$UID" -x wineserver); do
        if find "/proc/$wp/fd" -lname /dev/ntsync 2>/dev/null | grep -q .; then
            ok "partie en cours : wineserver (pid $wp) utilise ntsync"
        else
            info "partie en cours : wineserver (pid $wp) n'utilise pas ntsync (fsync/esync)"
        fi
    done
else
    info "optimisations stream désactivées (STREAM_TUNING=false)"
fi
fps=$FPS_LIMIT
[[ $fps == auto ]] && fps="$REFRESH (REFRESH)"
if [[ $FPS_LIMIT == 0 ]]; then
    info "pas de limite d'images par seconde (FPS_LIMIT=0)"
elif [[ $FPS_LIMIT_METHOD == mangohud ]]; then
    if compgen -G '/usr/share/vulkan/implicit_layer.d/MangoHud*.json' >/dev/null; then
        ok "limite à $fps images/s via MangoHud"
    else
        warn "FPS_LIMIT avec MangoHud, mais MangoHud est absent : repli sur DXVK/VKD3D (jeux Windows seulement)" "sudo pacman -S mangohud"
    fi
else
    ok "limite à $fps images/s via DXVK/VKD3D-Proton (jeux Windows sous Proton)"
fi

if ((${#STEAM_SETTINGS[@]})); then
    echo "== Réglages Steam (STEAM_SETTINGS)"
    if ! command -v python3 >/dev/null; then
        bad "python3 présent (STEAM_SETTINGS)" "sudo pacman -S python"
    else
        steamcfg=$(command -v steamd-steamcfg || echo "$(dirname "$(readlink -f "$0")")/steamd-steamcfg")
        for s in "${STEAM_SETTINGS[@]}"; do
            file=${s%%:*} rest=${s#*:}
            key=${rest%%=*} want=${rest#*=}
            cur=$(STEAMD_HOME=$STEAMD_HOME python3 "$steamcfg" get "$file" "$key" 2>&1 | sed 's/^.* : //' | sort -u | paste -sd,)
            if [[ $cur == "$want" ]]; then
                ok "$key = $want"
            else
                warn "$key vaut « ${cur:-?} », attendu « $want »" "appliqué au prochain démarrage de steamd (systemctl --user restart steamd)"
            fi
        done
    fi
fi

echo "== Réseau"
# Les deux Steam visent les mêmes ports : ils doivent appartenir au cgroup de steamd
cg=$(systemctl --user show -p ControlGroup --value steamd.service)
svc_pids=$(cat "/sys/fs/cgroup$cg/cgroup.procs" 2>/dev/null)
if [[ -n $svc_pids ]]; then
    # 27036 (découverte) doit être à steamd ; 27037 n'est ouvert que pendant certains streams
    for port in 27036 27037; do
        owners=$(ss -Htulnp "( sport = :$port )" | grep -o 'pid=[0-9]*' | cut -d= -f2 | sort -u)
        if [[ -z $owners && $port == 27037 ]]; then
            echo "     port 27037 libre (normal hors stream)"
            continue
        fi
        check "port $port tenu par le Steam de steamd" \
            "désactiver Remote Play et les transferts LAN dans le Steam du bureau, le relancer, puis systemctl --user restart steamd" \
            bash -c '[[ -n $1 ]] || exit 1; for o in $1; do grep -qx "$o" <<<"$2" || exit 1; done' _ "$owners" "$svc_pids"
    done
fi
echo "     Remote Play : UDP 27031-27036, TCP 27036-27037 à ouvrir si un pare-feu est actif"

echo "== Derniers logs"
journalctl --user -u steamd -n 30 --no-pager 2>/dev/null

echo
((ko == 0)) && echo "Tout est OK." || echo "$ko point(s) KO."
exit $((ko > 0))
