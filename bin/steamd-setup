#!/usr/bin/env bash
# Partie utilisateur de l'installation de steamd (idempotente).
#   steamd-setup                       configuration, groupe input, linger, services
#   steamd-setup --undo [options]      désactive les services
#     --remove-group    retirer l'utilisateur du groupe input
#     --disable-linger  désactiver le linger
#     --purge           supprimer ~/.config/steamd et le HOME du client steamd
set -euo pipefail

[[ $EUID -eq 0 ]] && { echo "Lancer en utilisateur, pas en root." >&2; exit 1; }

CONFDIR="${XDG_CONFIG_HOME:-$HOME/.config}/steamd"
POLKIT_MARK="${XDG_STATE_HOME:-$HOME/.local/state}/steamd/polkit-installed"
in_group() { id -nG "$USER" | tr ' ' '\n' | grep -qx input; }

if [[ ${1:-} != --undo ]]; then
    for c in gamescope steam pipewire wireplumber; do
        command -v "$c" >/dev/null || echo "Attention : $c introuvable (sudo pacman -S $c)" >&2
    done

    if [[ ! -e $CONFDIR/steamd.conf ]]; then
        for ex in "${XDG_DATA_HOME:-$HOME/.local/share}/steamd/steamd.conf.example" /usr/share/steamd/steamd.conf.example; do
            if [[ -r $ex ]]; then
                echo "→ configuration $CONFDIR/steamd.conf"
                install -Dm644 "$ex" "$CONFDIR/steamd.conf"
                break
            fi
        done
    fi

    reboot_needed=false
    if ! in_group; then
        echo "→ ajout de $USER au groupe input (sudo)"
        sudo usermod -aG input "$USER"
        reboot_needed=true
    fi

    for rules in "${XDG_DATA_HOME:-$HOME/.local/share}/steamd/polkit/60-steamd.rules" /usr/share/steamd/polkit/60-steamd.rules; do
        if [[ -r $rules ]]; then
            echo "→ règle polkit : profil d'énergie pendant les parties (sudo)"
            sed "s/@USER@/$USER/" "$rules" | sudo tee /etc/polkit-1/rules.d/60-steamd.rules >/dev/null
            sudo chmod 644 /etc/polkit-1/rules.d/60-steamd.rules
            # /etc/polkit-1/rules.d n'est pas lisible par l'utilisateur : trace pour steamd-doctor
            install -Dm644 /dev/null "$POLKIT_MARK"
            break
        fi
    done

    echo "→ linger (sudo)"
    sudo loginctl enable-linger "$USER"

    echo "→ services utilisateur"
    systemctl --user daemon-reload
    systemctl --user enable pipewire.socket pipewire-pulse.socket wireplumber.service
    systemctl --user disable steamd-session-hook.service 2>/dev/null || true
    systemctl --user enable steamd.service steamd-profiled.service

    echo
    echo "Prêt. Première configuration du client steamd (une seule fois, dans la session de bureau) :"
    echo "  steamd-launch --setup   connexion + Steam Guard, Remote Play activé, bibliothèque du bureau ajoutée"
    echo "Puis : systemctl --user start steamd (ou redémarrer)."
    $reboot_needed && echo "Redémarrage nécessaire pour la prise en compte du groupe input."
    echo "Diagnostic : steamd-doctor"
    exit 0
fi

shift
remove_group=false disable_linger=false purge=false
for a in "$@"; do
    case $a in
        --remove-group)   remove_group=true ;;
        --disable-linger) disable_linger=true ;;
        --purge)          purge=true ;;
        *) echo "Option inconnue : $a" >&2; exit 2 ;;
    esac
done

echo "→ arrêt et désactivation des services"
systemctl --user disable --now steamd-profiled.service steamd.service 2>/dev/null || true
# Sortie audio créée par AUDIO_ISOLATE
if command -v pactl >/dev/null; then
    # shellcheck source=/dev/null
    sink=$( [[ -r $CONFDIR/steamd.conf ]] && source "$CONFDIR/steamd.conf"; echo "${AUDIO_SINK:-steamd}" )
    pactl list short modules 2>/dev/null | awk -v a="sink_name=$sink" '$2 == "module-null-sink" && $3 == a {print $1}' |
        while read -r m; do pactl unload-module "$m"; done
fi
systemctl --user reset-failed steamd.service 2>/dev/null || true

# Le dossier des règles n'est pas lisible par l'utilisateur : on se fie aussi à la trace
if [[ -e $POLKIT_MARK || -e /etc/polkit-1/rules.d/60-steamd.rules ]]; then
    echo "→ règle polkit retirée (sudo)"
    sudo rm -f /etc/polkit-1/rules.d/60-steamd.rules
    rm -f "$POLKIT_MARK"
fi
if $remove_group && in_group; then
    echo "→ retrait du groupe input (sudo)"
    sudo gpasswd -d "$USER" input
fi
if $disable_linger; then
    echo "→ linger désactivé (sudo)"
    sudo loginctl disable-linger "$USER"
fi
if $purge; then
    STEAMD_HOME="${XDG_DATA_HOME:-$HOME/.local/share}/steamd-home"
    # shellcheck source=/dev/null
    [[ -r $CONFDIR/steamd.conf ]] && source "$CONFDIR/steamd.conf"
    echo "→ suppression de $CONFDIR et $STEAMD_HOME"
    rm -rf "$CONFDIR" "$STEAMD_HOME"
fi
