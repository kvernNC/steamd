#!/usr/bin/env bash
# Choisit le profil d'affichage de steamd selon le client Remote Play connecté
# (CLIENT_PROFILES), ou selon une demande « steamd-launch --profile ». Le
# changement redémarre Steam headless, jamais pendant une partie.
# Pendant une partie de Steam headless : veille bloquée (INHIBIT_SLEEP_DURING_GAME)
# et profil d'énergie GAME_POWER_PROFILE, restauré à la fin.
#   steamd-profiled            boucle (steamd-profiled.service)
#   steamd-profiled --clients  IP connectées au Steam de steamd et profil correspondant
set -euo pipefail

CONF="${XDG_CONFIG_HOME:-$HOME/.config}/steamd/steamd.conf"
CLIENT_PROFILES=() PROFILE_REVERT_AFTER=600 PROFILE_POLL=5
INHIBIT_SLEEP_DURING_GAME=true GAME_POWER_PROFILE=performance
# shellcheck source=/dev/null
[[ -r $CONF ]] && source "$CONF"

LAUNCH="$(dirname "$(readlink -f "$0")")/steamd-launch"
RUNDIR="${XDG_RUNTIME_DIR:-/run/user/$UID}/steamd"
PROFILE_FILE=$RUNDIR/profile
PROFILE_REQUEST=$RUNDIR/profile.request

log() { echo "steamd-profiled: $*" >&2; }

# Processus de steamd.service (Steam headless et ses jeux)
steamd_pids() {
    local cg
    cg=$(systemctl --user show -p ControlGroup --value steamd.service 2>/dev/null) || return 0
    # STEAMD_CGROUP_ROOT : pour les tests
    [[ -n $cg ]] && cat "${STEAMD_CGROUP_ROOT:-/sys/fs/cgroup}$cg/cgroup.procs" 2>/dev/null || true
}

# IP distantes des sockets établies du Steam de steamd, hors boucle locale. On y
# trouve aussi les serveurs de Valve : seules les IP de CLIENT_PROFILES comptent.
client_peers() {
    local pids
    pids=$(steamd_pids | paste -sd ' ')
    [[ -n $pids ]] || return 0
    ss -Htunp state established 2>/dev/null |
        awk -v pids="$pids" '
            BEGIN { n = split(pids, a, " "); for (i = 1; i <= n; i++) want[a[i]] = 1 }
            {
                for (i = 1; i <= NF; i++) if ($i ~ /^users:/) { peer = $(i - 1); users = $i }
                hit = 0
                while (match(users, /pid=[0-9]+/)) {
                    if (substr(users, RSTART + 4, RLENGTH - 4) in want) hit = 1
                    users = substr(users, RSTART + RLENGTH)
                }
                if (hit) print peer
            }' |
        sed -E 's/^\[//; s/\]?:[0-9*]+$//; s/^::ffff://' |
        grep -vE '^(127\.|::1$|$)' | sort -u || true
}

# Une partie lancée par Steam headless (« reaper SteamLaunch AppId=N ») ?
game_running() {
    local p cmd
    while read -r p; do
        cmd=$({ tr '\0' ' ' <"/proc/$p/cmdline"; } 2>/dev/null) || continue
        [[ $cmd == *SteamLaunch*AppId=* ]] && return 0
    done < <(steamd_pids)
    return 1
}

if [[ ${1:-} == --clients ]]; then
    mapfile -t peers < <(client_peers)
    if ((${#peers[@]} == 0)); then
        echo "aucune connexion établie pour le Steam de steamd (lancer un stream, puis relancer)"
        exit 0
    fi
    printf 'IP connectées au Steam de steamd :\n'
    printf '  %s\n' "${peers[@]}"
    want=$("$LAUNCH" --profile-for "${peers[@]}")
    echo "profil correspondant : ${want:-aucun (profil par défaut)}"
    exit 0
fi

case $GAME_POWER_PROFILE in
    performance | balanced | power-saver | none) ;;
    *) log "GAME_POWER_PROFILE invalide : « $GAME_POWER_PROFILE » (performance, balanced, power-saver ou none)"; exit 2 ;;
esac
[[ $INHIBIT_SLEEP_DURING_GAME == true || $INHIBIT_SLEEP_DURING_GAME == false ]] ||
    { log "INHIBIT_SLEEP_DURING_GAME invalide : « $INHIBIT_SLEEP_DURING_GAME » (true ou false)"; exit 2; }

inhibit_pid="" saved_profile="" in_game=false
game_on() {
    local msg="partie lancée"
    if [[ $INHIBIT_SLEEP_DURING_GAME == true ]] && command -v systemd-inhibit >/dev/null; then
        systemd-inhibit --what=sleep:idle --who=steamd --why="partie Remote Play en cours" --mode=block \
            sleep infinity &
        inhibit_pid=$!
        msg+=", veille bloquée"
    fi
    if [[ $GAME_POWER_PROFILE != none ]] && command -v powerprofilesctl >/dev/null; then
        saved_profile=$(powerprofilesctl get 2>/dev/null) || saved_profile=""
        if [[ -z $saved_profile || $saved_profile == "$GAME_POWER_PROFILE" ]]; then
            saved_profile=""
        elif powerprofilesctl set "$GAME_POWER_PROFILE" 2>/dev/null; then
            msg+=", profil d'énergie $saved_profile -> $GAME_POWER_PROFILE"
        else
            log "profil d'énergie $GAME_POWER_PROFILE refusé (règle polkit de steamd installée ? steamd-setup)"
            saved_profile=""
        fi
    fi
    log "$msg"
}
game_off() {
    local msg="partie terminée"
    if [[ -n $inhibit_pid ]]; then
        # systemd-inhibit et son « sleep » : la veille est libérée quand ils se terminent
        pkill -P "$inhibit_pid" 2>/dev/null || true
        kill "$inhibit_pid" 2>/dev/null || true
        inhibit_pid=""
        msg+=", veille libérée"
    fi
    if [[ -n $saved_profile ]]; then
        powerprofilesctl set "$saved_profile" 2>/dev/null && msg+=", profil d'énergie $saved_profile restauré"
        saved_profile=""
    fi
    log "$msg"
}
trap 'if $in_game; then game_off; fi; exit 0' TERM INT

mkdir -p "$RUNDIR"
last_seen=$SECONDS waiting=""
while sleep "$PROFILE_POLL"; do
    active=false game=false
    if systemctl --user -q is-active steamd.service; then
        active=true
        if game_running; then game=true; fi
    fi
    if [[ $game != "$in_game" ]]; then
        if $game; then game_on; else game_off; fi
        in_game=$game
    fi
    $active || continue
    cur=$(cat "$PROFILE_FILE" 2>/dev/null || echo default)
    target=$cur
    if [[ -s $PROFILE_REQUEST ]]; then
        target=$(head -n1 "$PROFILE_REQUEST")
        last_seen=$SECONDS
    elif ((${#CLIENT_PROFILES[@]})); then
        mapfile -t peers < <(client_peers)
        want=$("$LAUNCH" --profile-for "${peers[@]}")
        if [[ -n $want ]]; then
            target=$want
            last_seen=$SECONDS
        elif [[ $cur != default ]] && ((SECONDS - last_seen >= PROFILE_REVERT_AFTER)); then
            target=default
        fi
    fi

    if [[ $target == "$cur" ]]; then
        rm -f "$PROFILE_REQUEST"
        waiting=""
        continue
    fi
    if $game; then
        [[ $waiting == "$target" ]] || log "partie en cours : profil $target appliqué à la fin de la partie"
        waiting=$target
        continue
    fi
    log "profil $cur -> $target : redémarrage de Steam headless"
    echo "$target" >"$PROFILE_FILE"
    rm -f "$PROFILE_REQUEST"
    waiting=""
    systemctl --user restart steamd.service || log "redémarrage de steamd impossible"
done
