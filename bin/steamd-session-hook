#!/usr/bin/env bash
# Appelé par steamd-session-hook.service : login (session graphique ouverte) / logout.
set -euo pipefail

CONF="${XDG_CONFIG_HOME:-$HOME/.config}/steamd/steamd.conf"
STOP_ON_LOCAL_LOGIN=true RESTART_ON_LOCAL_LOGOUT=true
# shellcheck source=/dev/null
[[ -r $CONF ]] && source "$CONF"

case ${1:-} in
    login)
        if [[ $STOP_ON_LOCAL_LOGIN == true ]] && systemctl --user -q is-active steamd.service; then
            echo "steamd-session-hook: session locale ouverte, arrêt de steamd"
            systemctl --user stop steamd.service
        fi ;;
    logout)
        if [[ $RESTART_ON_LOCAL_LOGOUT == true ]] && systemctl --user -q is-enabled steamd.service; then
            echo "steamd-session-hook: session locale fermée, relance de steamd"
            # Échoue sans conséquence pendant un arrêt du système
            systemctl --user start --no-block steamd.service || true
        fi ;;
    *) echo "usage: $0 login|logout" >&2; exit 2 ;;
esac
