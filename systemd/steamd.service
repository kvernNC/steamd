[Unit]
Description=steamd : Steam Big Picture dans un gamescope headless (Remote Play)
Documentation=https://github.com/kvernNC/steamd
Wants=pipewire.socket pipewire-pulse.socket wireplumber.service
After=pipewire.socket pipewire-pulse.socket wireplumber.service
# Au plus 5 échecs en 5 minutes, ensuite on abandonne.
StartLimitIntervalSec=300
StartLimitBurst=5

[Service]
Type=simple
ExecStart=%h/.local/bin/steamd-launch
ExecStop=%h/.local/bin/steamd-launch --stop
Restart=on-failure
RestartSec=10
# 2 = configuration invalide, 3 = conflit (autre Steam ou session graphique)
RestartPreventExitStatus=2 3
# ExecStop laisse STOP_TIMEOUT (30 s par défaut) à Steam ; on garde de la marge.
TimeoutStopSec=60
KillMode=mixed

[Install]
WantedBy=default.target
